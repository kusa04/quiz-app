#!/bin/sh
# git push の直前に make check（lint + 型チェック + テスト）を実行する。
# 失敗したら push は中止される。
#
# 有効にする:       make setup（git config core.hooksPath .githooks を設定する）
# 一度だけ飛ばす:   git push --no-verify
set -e

cd "$(git rev-parse --show-toplevel)"

echo "pre-push: make check を実行します（飛ばすには git push --no-verify）"
make check
